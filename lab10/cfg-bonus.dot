
digraph BonusCFG {
graph [
    label="Lab 10 - bonus() Control Flow Graph",
    labelloc=t,
    fontsize=20,
    rankdir=TB,
    nodesep=0.7,
    ranksep=1.0,
    pad=0.4,
    splines=polyline
];
node [
    shape=box,
    style=rounded,
    fontsize=12,
    margin="0.2,0.12"
];

edge [
    fontsize=10
];

    start [label="31: bonus(attendance, threshold)", shape=oval];
    check [label="32: attendance == null || threshold < 0?", shape=diamond];
    error [label="33: throw IllegalArgumentException"];
    init [label="35-37: present=0; streak=0; best=0"];
    loop [label="38: next attendance element?", shape=diamond];
    positive [label="39: a > 0?", shape=diamond];
    increment [label="40-41: present++; streak++"];
    bestcheck [label="42: streak > best?", shape=diamond];
    updatebest [label="43: best = streak"];
    reset [label="46: streak = 0"];
    scoreinit [label="49: score = 0"];
    thresholdcheck [label="50: present >= threshold?", shape=diamond];
    scorefive [label="51: score = 5"];
    streakcheck [label="53: best >= 5?", shape=diamond];
    scorethree [label="54: score = score + 3"];
    finish [label="56: return score", shape=oval];

    start -> check;

    check -> error [label="T: bonusNullAttendance,\nbonusNegativeThreshold"];
    check -> init [label="F: bonusMixedAttendance"];

    init -> loop;

    loop -> positive [label="T: bonusMixedAttendance"];
    loop -> scoreinit [label="F: bonusEmptyAttendance"];

    positive -> increment [label="T: bonusFiveConsecutive"];
    positive -> reset [label="F: bonusMixedAttendance"];

    increment -> bestcheck;

    bestcheck -> updatebest [label="T: bonusFiveConsecutive"];
    bestcheck -> loop [label="F: bonusPreservesBestStreak"];

    updatebest -> loop;
    reset -> loop;

    scoreinit -> thresholdcheck;

    thresholdcheck -> scorefive [label="T: bonusMixedAttendance"];
    thresholdcheck -> streakcheck [label="F: bonusBelowThreshold"];

    scorefive -> streakcheck;

    streakcheck -> scorethree [label="T: bonusFiveConsecutive,\nbonusOnlyStreakPoints"];
    streakcheck -> finish [label="F: bonusMixedAttendance"];

    scorethree -> finish;
}
